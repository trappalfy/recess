# Robinhood Chain mainnet (docs.robinhood.com/chain/connecting). No value is hardcoded in the source.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
# The public endpoint is rate-limited; use a provider's endpoint in production.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# USDG (Global Dollar, 6 decimals) on Robinhood Chain (docs.robinhood.com/chain/contracts).
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Empty until the Recess contracts are deployed. While empty, pools read as empty
# and the buttons that would sign a transaction do nothing.
NEXT_PUBLIC_RECESS_MARKETS_ADDRESS=
# WalletConnect project id for the RainbowKit modal. Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_ID=
# Arbitrum One RPC for the Chainlink reference feeds, read from the browser.
NEXT_PUBLIC_PRICE_RPC_URL=https://arb1.arbitrum.io/rpc
